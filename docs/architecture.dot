digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.55", ranksep="0.65"];
  node [shape=rect, style="rounded,filled", fontname="Arial", fontsize=12, margin="0.15,0.10", color="#17564a", fillcolor="#e8f5ef", penwidth=1.5];
  edge [color="#555555", arrowsize=0.8, penwidth=1.3, fontname="Arial", fontsize=9];

  user [label="Evaluator / User\nBrowser"];
  frontend [label="HTML/CSS/JS\nUpload + Dashboard + Raw JSON"];
  api [label="FastAPI\n/api/v1 + Swagger"];
  filecheck [label="File Validation\nPDF/JPG/PNG, readable, <= 3 pages"];
  route [shape=diamond, label="Usable native\nPDF text?"];
  native [label="Native PDF Text\nFast path"];
  vision [label="Gemini Vision Primary\nScanned PDF / JPG / PNG"];
  fallback [label="Fallback\nTesseract OCR + Text LLM"];
  extract [label="Structured Extraction\nAll fields + tables + evidence\nExact period/header binding"];
  checks [label="Deterministic Python Validation\nPASS / FAIL / NOT_APPLICABLE"];
  audit [label="One Guarded Vision Audit Retry\nOnly if applicability preserved\nand validation improves"];
  db [label="Persistence\nSQLite (local/demo) / Managed Postgres (production)\nStored JSON result"];
  result [label="Result UI\nExtraction + validations"];
  deploy [label="Railway Deployment\nFrontend + FastAPI in one service"];

  user -> frontend;
  frontend -> api [label="multipart upload"];
  api -> filecheck;
  filecheck -> route [label="PASS"];
  route -> native [label="yes"];
  route -> vision [label="no"];
  native -> extract;
  vision -> extract;
  vision -> fallback [style=dashed, label="provider failure"];
  fallback -> extract;
  extract -> checks;
  checks -> audit [style=dashed, label="Vision + financial FAIL"];
  audit -> checks [style=dashed, label="grounded correction only"];
  checks -> db;
  db -> api [label="GET latest/list"];
  api -> result;
  result -> user;
  deploy -> frontend [style=dotted, label="hosts"];
  deploy -> api [style=dotted, label="hosts"];
}
