# Copy this file to .env and fill in real values for local development.
# NEVER commit the real .env file — it's already in .gitignore.

ENVIRONMENT=development

# --- Database ---
DATABASE_URL=sqlite:///./docint.db

# --- File upload limits ---
MAX_UPLOAD_SIZE_MB=15
MAX_PAGE_COUNT=3

# --- OCR ---
OCR_PROVIDER=tesseract
OCR_SPACE_API_KEY=helloworld
POPPLER_PATH=
TESSERACT_CMD=

# --- LLM extraction with provider fallback ---
# Default: Groq first. If Groq fails, Gemini is tried automatically.
# Set LLM_PROVIDER=gemini if you want Gemini first and Groq second.
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Optional second Gemini model after retries; leave blank if not needed.
GEMINI_FALLBACK_MODEL=

LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_SECONDS=1.0

# --- Financial validation tolerance ---
VALIDATION_ABS_TOLERANCE=0.01
VALIDATION_PCT_TOLERANCE=0.005

# --- Logging ---
LOG_LEVEL=INFO

# --- CORS ---
CORS_ALLOW_ORIGINS=*

# Multimodal model used for scanned PDFs/JPG/PNG. Tesseract is fallback only.
GEMINI_VISION_MODEL=gemini-2.5-flash
